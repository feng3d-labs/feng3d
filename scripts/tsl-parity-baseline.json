        "input: FragmentInput",
        ") -> @location(0) vec4<f32> {",
        "var uv = vec2<f32>(input.fragUV.x * uniforms.width, input.fragUV.y * uniforms.height);",
        "let pixel = vec2<u32>(u32(floor(uv.x)), u32(floor(uv.y)));",
