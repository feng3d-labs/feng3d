{
    "getABufferOpaqueWGSL": [
        "struct VertexOutput {",
        "@builtin(position) position: vec4<f32>",
        "@location(0) @interpolate(flat) instance: u32",
        "}",
        "struct Uniforms {",
        "modelViewProjectionMatrix: mat4x4<f32>",
        "maxStorableFragments: u32",
        "targetWidth: u32",
        "}",
        "@group(0) @binding(0) var<uniform> uniforms: Uniforms;",
        "@vertex",
        "fn main_vs(",
        "@location(0) position: vec4<f32>",
        "@builtin(instance_index) instanceIndex: u32",
        ") -> VertexOutput {",
        "var output: VertexOutput;",
        "let row = instanceIndex / 2u;",
        "let col = (instanceIndex % 2u);",
        "let rowOdd = f32((row % 2u));",
        "let xOffset = -62.5 + 15.625 + 62.5 * f32(col) + rowOdd * 31.25;",
        "let zOffset = -62.5 + 15.625 + 2.0 + f32(row) * 31.25;",
        "let offsetPos = vec4<f32>(position.x + xOffset, position.y, position.z + zOffset, position.w);",
        "output.position = uniforms.modelViewProjectionMatrix * offsetPos;",
        "output.instance = instanceIndex;",
        "return output;",
        "struct FragmentInput {",
        "@location(0) @interpolate(flat) instance: u32",
        "}",
        "@fragment",
        "fn main_fs(",
        "input: FragmentInput",
        ") -> @location(0) vec4<f32> {",
        "let color = array<vec3<f32>, 6>(vec3<f32>(1.0, 0.0, 0.0), vec3<f32>(0.0, 1.0, 0.0), vec3<f32>(0.0, 0.0, 1.0), vec3<f32>(1.0, 0.0, 1.0), vec3<f32>(1.0, 1.0, 0.0), vec3<f32>(0.0, 1.0, 1.0))[(input.instance % 6u)];",
        "return vec4<f32>(color, 1.0);"
    ],
