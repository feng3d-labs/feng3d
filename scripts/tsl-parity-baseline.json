        "let colorChanger = data[elementIndex];",
        "let subtracter = f32(colorChanger) / (uniforms.width * uniforms.height);",
        "let oneMinus = 1.0 - subtracter;",
        "if ((fragment_uniforms.highlight == 1u)) {",
        "let inFirstHalf = ((elementIndex % uniforms.blockHeight) < uniforms.blockHeight / 2u);",
        "return select(vec4<f32>(vec3<f32>(0.0, oneMinus, 0.0), 1.0), vec4<f32>(vec3<f32>(oneMinus, 0.0, 0.0), 1.0), inFirstHalf);",
