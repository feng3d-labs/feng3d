    "getDeferredFragmentDeferredRenderingWGSL": [
        "struct LightData {",
        "position: vec4<f32>",
        "color: vec3<f32>",
        "radius: f32",
        "}",
        "@group(1) @binding(0) var<storage, read> lightsBuffer: array<LightData>;",
        "struct Config {",
        "numLights: u32",
        "}",
        "@group(1) @binding(1) var<uniform> config: Config;",
        "@group(0) @binding(0) var gBufferPosition_texture: texture_2d<f32>;",
        "@group(0) @binding(1) var gBufferNormal_texture: texture_2d<f32>;",
        "@group(0) @binding(2) var gBufferAlbedo_texture: texture_2d<f32>;",
        "@fragment",
        "fn main(",
        "@builtin(position) fragCoord: vec4<f32>",
        ") -> @location(0) vec4<f32> {",
        "let texel = vec2<i32>(floor(fragCoord.xy));",
        "let position = textureLoad(gBufferPosition_texture, texel, 0u).xyz;",
        "if (position.z > 10000.0) {",
        "discard;",
        "let normal = textureLoad(gBufferNormal_texture, texel, 0u).xyz;",
        "let albedo = textureLoad(gBufferAlbedo_texture, texel, 0u).xyz;",
        "var result = vec3<f32>(0.0);",
        "for (var i: u32 = 0u; i < config.numLights; i = i + 1u) {",
        "let L = lightsBuffer[i].position.xyz - position;",
        "let distance = length(L);",
        "if (distance > lightsBuffer[i].radius) {",
        "continue;",
        "let lambert = max(dot(normal, normalize(L)), 0.0);",
        "let falloff = pow(1.0 - distance / lightsBuffer[i].radius, 2.0);",
        "result = result + falloff * lambert * lightsBuffer[i].color * albedo;",
        "result = result + vec3<f32>(0.2);",
        "return vec4<f32>(result, 1.0);"
    ],
