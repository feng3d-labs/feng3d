{
  "name": "feng3d-mono",
  "version": "0.0.1",
  "description": "Feng3D Web3D Engine Monorepo",
  "homepage": "https://feng3d.com",
  "author": "feng",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install && npm run install:packages",
    "install:packages": "npm install --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:watch": "npm run build:watch --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ui": "vitest --ui",
    "types": "tsc --build",
    "lint": "eslint . --ext .js,.ts --max-warnings 0",
    "lintfix": "eslint . --ext .js,.ts --fix",
    "docs": "typedoc",
    "release": "npm run clean && npm run lint && npm run test && npm run build && npm run docs",
    "release:webgpu": "npm run release -w @feng3d/webgpu",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@eslint/js": "9.0.0",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "eslint": "9.26.0",
    "fast-glob": "^3.3.3",
    "globals": "14.0.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.10",
    "rimraf": "6.0.1",
    "tslib": "2.8.1",
    "typedoc": "0.28.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vite": "6.3.5",
    "vitest": "3.1.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix --max-warnings 0"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/feng3d/feng3d.git"
  }
}
