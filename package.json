{
  "name": "@feng3d/monorepo",
  "version": "0.0.1",
  "type": "module",
  "description": "Feng3D Web3D Engine Monorepo",
  "homepage": "https://feng3d.com",
  "author": "feng",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/*/examples"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces --if-present",
    "clean:all": "git clean -fdx",
    "build": "npm run build --workspaces --if-present",
    "build:watch": "npm run build:watch --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ui": "vitest --ui",
    "types": "tsc --build",
    "types:watch": "tsc --build --watch",
    "lint": "eslint \"packages/**/*.ts\"",
    "lintfix": "eslint \"packages/**/*.ts\" --fix",
    "docs": "typedoc",
    "release": "npm run clean && npm run lint && npm run test && npm run build && npm run docs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "@webgpu/types": "0.1.60",
    "eslint": "10.2.1",
    "globals": "17.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "rimraf": "6.1.3",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "vite": "5.4.21",
    "vitest": "3.1.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix --max-warnings 0"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/feng3d/feng3d.git"
  }
}
