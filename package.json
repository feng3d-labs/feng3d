{
  "name": "feng3d-monorepo",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Feng3D monorepo 根（workspace root）；feng3d 引擎包本身在 packages/feng3d/",
  "workspaces": [
    "packages/*",
    "packages/*/examples",
    "examples"
  ],
  "scripts": {
    "clean": "rimraf lib dist public",
    "clean:all": "git clean -fdx",
    "clean:workspaces": "npm run clean --workspaces --if-present",
    "build": "npm run build --workspace feng3d",
    "build:workspaces": "npm run build --workspaces --if-present",
    "build:watch": "npm run build:watch --workspaces --if-present",
    "watch": "npm run watch --workspace feng3d",
    "test": "vitest",
    "test:run": "vitest run",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:editor": "playwright test --config playwright.editor.config.ts",
    "test:e2e:full": "cross-env E2E_TIER=full playwright test",
    "test:e2e:full:update": "cross-env E2E_TIER=full playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "types": "npm run types --workspace feng3d",
    "types:workspaces": "npm run types --workspaces --if-present",
    "types:packages": "node scripts/run-in-packages.mjs types",
    "build:packages": "node scripts/run-in-packages.mjs build",
    "prelint": "npm run build --workspace eslint-plugin-feng3d",
    "prelint:ci": "npm run build --workspace eslint-plugin-feng3d",
    "lint": "eslint \"packages/feng3d/src/**/*.ts\" \"packages/**/*.ts\"",
    "lint:ci": "eslint \"packages/feng3d/src/**/*.ts\" \"packages/**/*.ts\" --max-warnings 0",
    "lintfix": "eslint \"packages/feng3d/src/**/*.ts\" \"packages/**/*.ts\" --fix",
    "docs": "npm run docs --workspace feng3d",
    "release:packages": "node scripts/release-packages.mjs",
    "release:dry-run": "node scripts/release-packages.mjs --dry-run",
    "ci": "npm run lint:ci && npm run test:run && npm run types:packages && npm run build:packages && npm run release:dry-run -- --force --no-build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "@webgpu/types": "0.1.60",
    "cross-env": "10.1.0",
    "eslint": "10.2.1",
    "globals": "17.5.0",
    "playwright": "1.62.0",
    "rimraf": "6.1.3",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/feng3d/feng3d.git"
  }
}
