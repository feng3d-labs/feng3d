{
  "name": "@feng3d/monorepo",
  "version": "0.0.1",
  "description": "Feng3D Web3D Engine Monorepo",
  "homepage": "https://feng3d.com",
  "author": "feng",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:watch": "npm run build:watch --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ui": "vitest --ui",
    "types": "tsc --build",
    "lint": "eslint .",
    "lintfix": "eslint . --fix",
    "docs": "typedoc",
    "release": "npm run clean && npm run lint && npm run test && npm run build && npm run docs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "@webgpu/types": "0.1.60",
    "eslint": "9.15.0",
    "globals": "15.12.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "rimraf": "6.0.1",
    "typedoc": "0.28.4",
    "typescript": "5.8.3",
    "vite": "5.4.11",
    "vitest": "3.1.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix --max-warnings 0"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/feng3d/feng3d.git"
  }
}
