{
  "name": "feng3d",
  "version": "0.6.0",
  "type": "module",
  "description": "Feng3D Web3D Engine",
  "homepage": "https://feng3d.com",
  "author": "feng",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "lib"
  ],
  "workspaces": [
    "packages/*",
    "examples"
  ],
  "scripts": {
    "clean": "rimraf lib dist public",
    "clean:all": "git clean -fdx",
    "clean:workspaces": "npm run clean --workspaces --if-present",
    "build": "tsc",
    "build:workspaces": "npm run build --workspaces --if-present",
    "build:watch": "npm run build:watch --workspaces --if-present",
    "watch": "tsc -w",
    "test": "npm run test --workspaces --if-present",
    "test:ui": "vitest --ui",
    "types": "tsc --noEmit",
    "types:watch": "tsc --noEmit --watch",
    "lint": "eslint \"src/**/*.ts\" \"packages/**/*.ts\"",
    "lintfix": "eslint \"src/**/*.ts\" \"packages/**/*.ts\" --fix",
    "docs": "typedoc",
    "release": "npm run clean && npm run lint && npm run test && npm run build && npm run docs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "@webgpu/types": "0.1.60",
    "eslint": "10.2.1",
    "globals": "17.5.0",
    "rimraf": "6.1.3",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "vite": "5.4.21",
    "vitest": "3.1.3"
  },
  "dependencies": {
    "@feng3d/assets": "*",
    "@feng3d/event": "*",
    "@feng3d/filesystem": "*",
    "@feng3d/math": "*",
    "@feng3d/objectview": "*",
    "@feng3d/particlesystem": "*",
    "@feng3d/path": "*",
    "@feng3d/polyfill": "*",
    "@feng3d/reactivity": "*",
    "@feng3d/serialization": "*",
    "@feng3d/shortcut": "*",
    "@feng3d/terrain": "*",
    "@feng3d/ui": "*",
    "@feng3d/watcher": "*",
    "@feng3d/webgpu": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/feng3d/feng3d.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
