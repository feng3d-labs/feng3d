{
  "name": "feng3d-monorepo",
  "version": "0.9.0",
  "description": "feng3d Web3D Engine Monorepo",
  "private": true,
  "author": "feng",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -r --filter './packages/**' run dev --if-present",
    "build": "pnpm -r --filter './packages/**' run build --if-present",
    "test": "pnpm -r --filter './packages/**' run test --if-present",
    "lint": "pnpm -r --filter './packages/**' run lint --if-present",
    "clean": "pnpm -r --filter './packages/**' run clean --if-present",
    "clean:all": "git clean -fdx"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/feng3d/feng3d.git"
  },
  "devDependencies": {
    "@feng3d/cli": "^0.0.19"
  },
  "packageManager": "pnpm@9.0.0"
}
