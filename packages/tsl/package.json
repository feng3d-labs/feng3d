{
    "name": "@feng3d/tsl",
    "version": "0.2.0",
    "description": "feng3d引擎的着色器语言库，使用typescript编写着色器语言，并生成WebGPU的着色器代码。",
    "author": "feng",
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts"
        }
    },
    "scripts": {
        "clean": "rimraf lib dist public",
        "build": "tsc",
        "watch": "tsc -w",
        "test": "vitest",
        "types": "tsc"
    },
    "files": [
        "src",
        "lib"
    ],
    "repository": {
        "type": "git",
        "url": "https://gitee.com/feng3d/tsl.git"
    },
    "publishConfig": {
        "access": "public"
    }
}
