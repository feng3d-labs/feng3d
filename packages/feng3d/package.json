{
  "name": "feng3d",
  "version": "0.6.0",
  "type": "module",
  "description": "Feng3D Web3D Engine",
  "homepage": "https://feng3d.com",
  "author": "feng",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "rimraf lib dist public",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest",
    "types": "tsc",
    "docs": "typedoc",
    "release": "npm run clean && npm run test && npm run build && npm run docs"
  },
  "files": [
    "src",
    "lib"
  ],
  "dependencies": {
    "@feng3d/event": "*",
    "@feng3d/math": "*",
    "@feng3d/objectview": "*",
    "@feng3d/particlesystem": "*",
    "@feng3d/path": "*",
    "@feng3d/polyfill": "*",
    "@feng3d/reactivity": "*",
    "@feng3d/serialization": "*",
    "@feng3d/shortcut": "*",
    "@feng3d/terrain": "*",
    "@feng3d/webgpu": "*"
  },
  "devDependencies": {
    "typedoc": "0.28.19"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/feng3d/feng3d.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
