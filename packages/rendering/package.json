{
  "name": "@feng3d/rendering",
  "version": "0.1.0",
  "description": "WebGPU GPU 驱动渲染系统",
  "homepage": "https://feng3d.com/rendering/",
  "author": "feng",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "rimraf lib dist",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest",
    "types": "tsc",
    "dev": "npm run dev --workspace=examples",
    "dev:examples": "vite --config examples/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/feng3d/feng3d.git"
  },
  "files": [
    "src",
    "lib"
  ],
  "keywords": [
    "webgpu",
    "gpu-driven",
    "rendering",
    "indirect-drawing",
    "compute-shader"
  ],
  "dependencies": {
    "@feng3d/reactivity": "*",
    "@feng3d/webgpu": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
