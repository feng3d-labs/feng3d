{
  "name": "@feng3d/c-preprocessor",
  "version": "0.0.4",
  "description": "类似C语言的Javascript预处理器，被用于处理feng3d中的GLSL代码。",
  "author": "feng",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "rimraf lib dist public",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest",
    "types": "tsc"
  },
  "files": [
    "src",
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitee.com/feng3d/feng3d.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@feng3d/event": "*",
    "@feng3d/path": "*",
    "@types/js-beautify": "*",
    "js-beautify": "*"
  }
}