{
  "name": "feng3d-examples",
  "version": "0.6.0",
  "description": "feng3d引擎示例",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "npm run dev",
    "clean": "rimraf \"{out,public,dist}\"",
    "watch": "tsc -w --noEmit",
    "deploy": "npm run clean && npm run build && node scripts/deploy.js",
    "release": "npm run clean && npm run build && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/feng3d/examples.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "libs",
    "out",
    "resources",
    "src",
    "examples.html",
    "examples.js",
    "index.html",
    "index.js"
  ],
  "keywords": [
    "feng3d",
    "examples",
    "webgl",
    "3dEngine"
  ],
  "author": "feng",
  "license": "ISC",
  "devDependencies": {
    "@types/opentype.js": "1.3.9",
    "opentype.js": "1.3.5"
  },
  "dependencies": {
    "@feng3d/addons": "*",
    "@feng3d/error-logger": "*",
    "feng3d": "*"
  }
}
