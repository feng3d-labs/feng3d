{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noImplicitAny": false,
        "sourceMap": true,
        "declarationMap": true,
        "declaration": true,
        "experimentalDecorators": true,
        "skipLibCheck": true,
        "noEmit": true,
        "lib": [
            "ES2022",
            "DOM",
        ],
        "outDir": "lib"
    },
    "include": [
        "src/**/*.ts"
    ]
}